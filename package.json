{
    "name": "squelify",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "A modern headless CMS and backend-as-a-service platform",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/squelify/squelify.git"
    },
    "bugs": {
        "url": "https://github.com/squelify/squelify/issues"
    },
    "homepage": "https://github.com/squelify/squelify",
    "config": {
        "image": "ghcr.io/squelify/squelify"
    },
    "scripts": {
        "dev": "nitro dev",
        "build": "nitro build",
        "prepare": "nitro prepare",
        "start": "node --import dotenv/config build/server/index.mjs",
        "docker:build": "docker build -f Dockerfile . -t $npm_package_config_image:latest-dev -t $npm_package_config_image:$npm_package_version-dev",
        "docker:push": "docker push $npm_package_config_image:latest-dev && docker push $npm_package_config_image:$npm_package_version-dev",
        "docker:run": "pnpm --silent run dockerx --name $npm_package_name $npm_package_config_image:$npm_package_version-dev",
        "docker:shell": "pnpm --silent run dockerx --entrypoint /bin/sh $npm_package_config_image:$npm_package_version-dev",
        "docker:images": "docker image list --filter reference=$npm_package_config_image:*",
        "dockerx": "docker run --network=host --rm -it --env-file .env -v $(pwd)/storage:/srv/storage",
        "compose:cleanup": "docker compose -f compose.yaml down --remove-orphans --volumes",
        "compose:up": "docker compose -f compose.yaml up --detach --remove-orphans",
        "compose:down": "docker compose -f compose.yaml down --remove-orphans",
        "check": "biome check . --write",
        "format": "biome format . --write",
        "lint": "biome lint . --write",
        "postinstall": "lefthook install || true",
        "pre-commit": "lefthook run pre-commit --force",
        "cleanup": "pnpm --stream --color \"/cleanup:(?!data)/\"",
        "cleanup:dev": "pnpm dlx rimraf build output .{nitro,output}",
        "cleanup:deps": "pnpm dlx rimraf pnpm-lock.yaml node_modules",
        "cleanup:data": "pnpm dlx rimraf storage temp .{data,temp}",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "changelog-full": "git-cliff -o CHANGELOG.md -c cliff-full.toml",
        "knip": "knip -c knip.jsonc --reporter markdown --no-exit-code",
        "cmd": "tsx --tsconfig tsconfig.app.json server/cmd/index.ts",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.812.0",
        "@aws-sdk/s3-request-presigner": "^3.812.0",
        "@codemirror/autocomplete": "^6.18.6",
        "@codemirror/commands": "^6.8.1",
        "@codemirror/lang-html": "^6.4.9",
        "@codemirror/lang-json": "^6.0.1",
        "@codemirror/lang-sql": "^6.8.0",
        "@codemirror/language": "^6.11.0",
        "@codemirror/search": "^6.5.11",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.36.8",
        "@dagrejs/dagre": "^1.1.4",
        "@electric-sql/pglite": "^0.3.1",
        "@glideapps/glide-data-grid": "^6.0.3",
        "@headless-tree/core": "^1.0.1",
        "@headless-tree/react": "^1.0.1",
        "@lezer/highlight": "^1.2.1",
        "@nanostores/persistent": "^1.0.0",
        "@nanostores/react": "^1.0.0",
        "@noble/hashes": "^1.8.0",
        "@replit/codemirror-indentation-markers": "^6.5.3",
        "@squelify/kysely-pglite": "^0.1.0",
        "@tanstack/react-query": "^5.76.1",
        "@tanstack/react-query-devtools": "^5.76.1",
        "@trpc/client": "^11.1.2",
        "@trpc/server": "^11.1.2",
        "@trpc/tanstack-react-query": "^11.1.2",
        "@unhead/react": "^2.0.9",
        "@xyflow/react": "^12.6.4",
        "cmdk": "^1.1.1",
        "codemirror": "^6.0.1",
        "consola": "^3.4.2",
        "date-fns": "^4.1.0",
        "globby": "^14.1.0",
        "http-status": "^2.1.0",
        "input-otp": "^1.4.2",
        "kysely": "^0.28.2",
        "kysely-postgres-js": "^2.0.0",
        "lucide-react": "^0.511.0",
        "make-dir": "^5.0.0",
        "nanostores": "^1.0.1",
        "nuqs": "^2.4.3",
        "ohash": "^2.0.11",
        "postgres": "^3.4.5",
        "pretty-bytes": "^7.0.0",
        "radix-ui": "^1.4.1",
        "react": "^19.1.0",
        "react-day-picker": "^9.7.0",
        "react-dom": "^19.1.0",
        "react-error-boundary": "^6.0.0",
        "react-router": "^7.6.0",
        "redactyl.js": "^1.6.0",
        "sonner": "^2.0.3",
        "std-env": "^3.9.0",
        "superjson": "^2.2.2",
        "twistail-utils": "^0.11.0",
        "ua-parser-js": "^2.0.3",
        "uncrypto": "^0.1.3",
        "uuidkey": "^0.1.8",
        "zod": "next"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@scalar/api-reference": "^1.28.34",
        "@tailwindcss/postcss": "^4.1.7",
        "@types/node": "^22.15.19",
        "@types/react": "^19.1.4",
        "@types/react-dom": "^19.1.5",
        "@vitejs/plugin-react": "^4.4.1",
        "citty": "^0.1.6",
        "dotenv": "^16.5.0",
        "git-cliff": "^2.8.0",
        "h3": "^1.15.3",
        "knip": "^5.56.0",
        "lefthook": "^1.11.13",
        "nitropack": "^2.11.12",
        "npm-check-updates": "^18.0.1",
        "postcss": "^8.5.3",
        "postcss-load-config": "^6.0.1",
        "sonda": "^0.7.1",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.7",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "vite": "^6.3.5",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "packageManager": "pnpm@10.11.0",
    "pnpm": {
        "onlyBuiltDependencies": ["@biomejs/biome", "@parcel/watcher", "esbuild"]
    }
}
