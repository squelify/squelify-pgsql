{
    "name": "squelify",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "A modern headless CMS and backend-as-a-service platform",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/squelify/squelify.git"
    },
    "bugs": {
        "url": "https://github.com/squelify/squelify/issues"
    },
    "homepage": "https://github.com/squelify/squelify",
    "config": {
        "image": "ghcr.io/squelify/squelify"
    },
    "scripts": {
        "dev": "nitro dev",
        "build": "nitro build",
        "prepare": "nitro prepare",
        "start": "node --import dotenv/config build/server/index.mjs",
        "docker:build": "docker build -f Dockerfile . --build-arg DISTROLESS_TAG=debug-nonroot -t $npm_package_config_image:$npm_package_version-dev",
        "docker:push": "docker push $npm_package_config_image:latest-dev && docker push $npm_package_config_image:$npm_package_version-dev",
        "docker:run": "pnpm --silent run dockerx --name $npm_package_name $npm_package_config_image:$npm_package_version-dev",
        "docker:shell": "pnpm --silent run dockerx --entrypoint /busybox/sh $npm_package_config_image:$npm_package_version-dev",
        "docker:prune": "docker image rm --force $(docker image list --filter reference=$npm_package_config_image:* -q)",
        "docker:images": "docker image list --filter reference=$npm_package_config_image:*",
        "dockerx": "docker run --platform=linux/amd64 --network=host --rm -it --env-file .env -v $(pwd)/storage:/srv/storage",
        "compose:cleanup": "docker compose -f compose.yaml down --remove-orphans --volumes",
        "compose:up": "docker compose -f compose.yaml up --detach --remove-orphans",
        "compose:down": "docker compose -f compose.yaml down --remove-orphans",
        "check": "biome check . --write",
        "format": "biome format . --write",
        "lint": "biome lint . --write",
        "postinstall": "lefthook install || true",
        "pre-commit": "lefthook run pre-commit --force",
        "cleanup": "pnpm --stream --color \"/cleanup:(?!data)/\"",
        "cleanup:dev": "pnpm dlx rimraf build output .{nitro,output}",
        "cleanup:deps": "pnpm dlx rimraf pnpm-lock.yaml node_modules",
        "cleanup:data": "pnpm dlx rimraf storage temp .{data,temp}",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "changelog-full": "git-cliff -o CHANGELOG.md -c cliff-full.toml",
        "knip": "knip -c knip.jsonc --reporter markdown --no-exit-code",
        "cmd": "tsx --tsconfig tsconfig.app.json server/cmd/index.ts",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.896.0",
        "@aws-sdk/s3-request-presigner": "^3.896.0",
        "@codemirror/autocomplete": "^6.18.7",
        "@codemirror/commands": "^6.8.1",
        "@codemirror/lang-html": "^6.4.10",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.11.3",
        "@codemirror/search": "^6.5.11",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.38.3",
        "@dagrejs/dagre": "^1.1.5",
        "@electric-sql/pglite": "^0.3.10",
        "@glideapps/glide-data-grid": "^6.0.3",
        "@headless-tree/core": "^1.4.0",
        "@headless-tree/react": "^1.4.0",
        "@lezer/highlight": "^1.2.1",
        "@nanostores/persistent": "^1.1.0",
        "@nanostores/react": "^1.0.0",
        "@noble/hashes": "^2.0.1",
        "@replit/codemirror-indentation-markers": "^6.5.3",
        "@squelify/kysely-pglite": "^0.2.0",
        "@tanstack/react-query": "^5.90.2",
        "@tanstack/react-query-devtools": "^5.90.2",
        "@trpc/client": "^11.6.0",
        "@trpc/server": "^11.6.0",
        "@trpc/tanstack-react-query": "^11.6.0",
        "@unhead/react": "^2.0.17",
        "@xyflow/react": "^12.8.5",
        "cmdk": "^1.1.1",
        "codemirror": "^6.0.2",
        "consola": "^3.4.2",
        "date-fns": "^4.1.0",
        "globby": "^14.1.0",
        "http-status": "^2.1.0",
        "input-otp": "^1.4.2",
        "kysely": "^0.28.7",
        "kysely-postgres-js": "^3.0.0",
        "lucide-react": "^0.544.0",
        "make-dir": "^5.1.0",
        "nanostores": "^1.0.1",
        "nuqs": "^2.6.0",
        "ohash": "^2.0.11",
        "postgres": "^3.4.7",
        "pretty-bytes": "^7.1.0",
        "radix-ui": "^1.4.3",
        "react": "^19.1.1",
        "react-day-picker": "^9.11.0",
        "react-dom": "^19.1.1",
        "react-error-boundary": "^6.0.0",
        "react-router": "^7.9.2",
        "redactyl.js": "^1.6.0",
        "sonner": "^2.0.7",
        "std-env": "^3.9.0",
        "superjson": "^2.2.2",
        "twistail-utils": "^0.11.0",
        "ua-parser-js": "^2.0.5",
        "uncrypto": "^0.1.3",
        "uuidkey": "^0.1.8",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
        "@scalar/api-reference": "^1.36.0",
        "@tailwindcss/postcss": "^4.1.13",
        "@types/node": "^24.5.2",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.3",
        "citty": "^0.1.6",
        "dotenv": "^17.2.2",
        "git-cliff": "^2.10.1",
        "h3": "^1.15.4",
        "knip": "^5.64.0",
        "lefthook": "^1.13.4",
        "nitropack": "^2.12.6",
        "npm-check-updates": "^18.3.0",
        "postcss": "^8.5.6",
        "postcss-load-config": "^6.0.1",
        "sonda": "^0.9.0",
        "tailwind-variants": "^3.1.1",
        "tailwindcss": "^4.1.13",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2",
        "vite": "npm:rolldown-vite@7.1.13",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "packageManager": "pnpm@10.17.1",
    "pnpm": {
        "overrides": {
            "vite": "npm:rolldown-vite@7.1.13"
        },
        "onlyBuiltDependencies": [
            "@biomejs/biome",
            "@parcel/watcher",
            "esbuild"
        ]
    }
}
