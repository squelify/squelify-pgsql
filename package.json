{
    "name": "squelify",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "A modern headless CMS and backend-as-a-service platform",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/squelify/squelify.git"
    },
    "bugs": {
        "url": "https://github.com/squelify/squelify/issues"
    },
    "homepage": "https://github.com/squelify/squelify#readme",
    "config": {
        "image": "ghcr.io/squelify/squelify"
    },
    "scripts": {
        "dev": "nitro dev",
        "build": "nitro build",
        "prepare": "nitro prepare",
        "start": "node build/server/index.mjs",
        "docker:build": "docker build -f Dockerfile . -t $npm_package_config_image:latest -t $npm_package_config_image:$npm_package_version",
        "docker:push": "docker push $npm_package_config_image:latest && docker push $npm_package_config_image:$npm_package_version",
        "docker:run": "pnpm --silent run dockerx --name $npm_package_name $npm_package_config_image:$npm_package_version",
        "docker:shell": "pnpm --silent run dockerx --entrypoint /bin/sh $npm_package_config_image:$npm_package_version",
        "docker:images": "docker image list --filter reference=$npm_package_config_image:*",
        "dockerx": "docker run --network=host --rm -it --env-file .env -v $(pwd)/storage:/srv/storage",
        "compose:cleanup": "docker compose -f compose.yaml down --remove-orphans --volumes",
        "compose:up": "docker compose -f compose.yaml up --detach --remove-orphans",
        "compose:down": "docker compose -f compose.yaml down --remove-orphans",
        "check": "biome check . --write",
        "format": "biome format . --write",
        "lint": "biome lint . --write",
        "postinstall": "lefthook install || true",
        "pre-commit": "lefthook run pre-commit --force",
        "cleanup": "pnpm --stream --color \"/cleanup:(?!data)/\"",
        "cleanup:dev": "pnpm dlx rimraf build output .{nitro,output}",
        "cleanup:deps": "pnpm dlx rimraf pnpm-lock.yaml node_modules",
        "cleanup:data": "pnpm dlx rimraf storage temp .{data,temp}",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "changelog-full": "git-cliff -o CHANGELOG.md -c cliff-full.toml",
        "knip": "knip -c knip.jsonc --reporter markdown --no-exit-code",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@electric-sql/pglite": "^0.2.17",
        "@nanostores/persistent": "^1.0.0",
        "@nanostores/react": "^1.0.0",
        "@noble/hashes": "^1.7.1",
        "@tanstack/react-query": "^5.73.3",
        "@tanstack/react-query-devtools": "^5.73.3",
        "@trpc/client": "^11.1.0",
        "@trpc/server": "^11.1.0",
        "@trpc/tanstack-react-query": "^11.1.0",
        "@unhead/react": "^2.0.5",
        "allotment": "^1.20.3",
        "cmdk": "^1.1.1",
        "consola": "^3.4.2",
        "date-fns": "^4.1.0",
        "globby": "^14.1.0",
        "h3": "^1.15.1",
        "http-status": "^2.1.0",
        "input-otp": "^1.4.2",
        "kysely": "^0.28.0",
        "kysely-pglite": "^0.6.1",
        "kysely-postgres-js": "^2.0.0",
        "lucide-react": "^0.487.0",
        "make-dir": "^5.0.0",
        "nanostores": "^1.0.1",
        "next-themes": "^0.4.6",
        "ohash": "^2.0.11",
        "postgres": "^3.4.5",
        "pretty-bytes": "^6.1.1",
        "radix-ui": "^1.2.0",
        "react": "^19.1.0",
        "react-day-picker": "^9.6.6",
        "react-dom": "^19.1.0",
        "react-error-boundary": "^5.0.0",
        "react-router": "^7.5.0",
        "redactyl.js": "^1.6.0",
        "sonner": "^2.0.3",
        "std-env": "^3.9.0",
        "superjson": "^2.2.2",
        "twistail-utils": "^0.11.0",
        "ua-parser-js": "^2.0.3",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@tailwindcss/postcss": "^4.1.3",
        "@types/node": "^22.14.1",
        "@types/react": "^19.1.1",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.3.4",
        "citty": "^0.1.6",
        "dotenv": "^16.5.0",
        "git-cliff": "^2.8.0",
        "knip": "^5.50.2",
        "lefthook": "^1.11.9",
        "nitropack": "^2.11.9",
        "npm-check-updates": "^17.1.18",
        "postcss": "^8.5.3",
        "postcss-load-config": "^6.0.1",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.3",
        "typescript": "^5.8.3",
        "vite": "^6.2.6",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "packageManager": "pnpm@10.8.0",
    "pnpm": {
        "onlyBuiltDependencies": ["@biomejs/biome", "@parcel/watcher", "esbuild"]
    }
}
